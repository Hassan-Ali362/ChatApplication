// Global variables
var editor_theme = "twilight";
var editor_font_size = 16;
var editor_invisible = false;
var editor_gutter = true;
var editor_tab_size = 4;
var editor_type = "null";
var editor_soft_wrap = "true";
var editor = null;
var terminal = null;
var isMobile = false;
var preview = false;
var compile = true;
var execute = false;
var timer = 0;
var socket = null;
var result = "";
var cmd = "";
var init = 0;
var clipboard;
// At the top with other global variables
var isResizing = false;

document.addEventListener("DOMContentLoaded", function(event) {
    // Initialize editors
    setupEditors();

    // Setup UI and event listeners
    setupEventListeners();

    // Initialize UI with saved preferences
    loadSavedPreferences();

    // Configure display settings based on language
    configureInterfaceForLanguage();

    // Set cookie
    document.cookie = "_tptx=www.tutorialspoint.com; path=/; domain=.tutorialspoint.com; secure;SameSite=None";

    // Initialize preview if needed
    if (preview) {
        updatePreview();
    }
});

function setupEditors() {
    // Initialize main editor
    editor = ace.edit("editor");
    editor.setTheme("ace/theme/" + editor_theme);
    editor.getSession().setMode("ace/mode/" + modename);
    editor.getSession().on('change', function() {
        editor.resize(true);
    });
    editor.setOptions({
        tabSize: "4",
        fontSize: "14px",
        showGutter: true,
        highlightActiveLine: true,
        wrap: true,
        useWorker: false,
        overwrite: false,
        tooltipFollowsMouse: false,
        dragEnabled: false,
        showPrintMargin: false,
        useSoftTabs: true
    });

    // Initialize terminal editor
    terminal = ace.edit("terminal");
    terminal.setTheme("ace/theme/" + editor_theme);
    terminal.getSession().setMode("ace/mode/text");
    terminal.getSession().on('change', function() {
        terminal.resize(true);
    });
    terminal.setOptions({
        fontSize: "14px",
        showGutter: false,
        highlightActiveLine: false,
        behavioursEnabled: false,
        wrapBehavioursEnabled: false,
        wrap: true,
        useWorker: true,
        overwrite: false,
        dragEnabled: false,
        cursorStyle: "slim",
        showPrintMargin: true,
        useSoftTabs: true
    });
    terminal.setOption("showInvisibles", false);
    terminal.renderer.setPadding(10);
    terminal.renderer.setScrollMargin(5);
    terminal.container.style.lineHeight = "22px";
    terminal.getSession().on('change', () => {
        terminal.renderer.scrollToLine(Number.POSITIVE_INFINITY);
    });

    // Add terminal enter command
    terminal.commands.addCommand({
        name: "TerminalEnter",
        bindKey: {
            win: "Enter",
            mac: "Enter"
        },
        exec: function evaluate() {
            if (!init) {
                initSocket();
            }
            cmd = terminal.getValue().slice(result.length);
            if (cmd === "clear") {
                terminal.setValue("", 1);
                terminal.focus();
                return;
            }
            if (socket && !socket.connected) {
                /* If socket is disconnected then connect it again */
                console.log("Going to reconnect");
                socket.connect();
                timer = 0;
                terminal.focus();
            }
            socket.emit("command", cmd);
            return false;
        }
    });

    editor.container.style.lineHeight = "22px";
}

function setupEventListeners() {
    // Editor container setup
    const editorContainer = document.querySelector(".editor-container");
    if (editorContainer) {
        setupNavigation(editorContainer);
        setupTabs(editorContainer);
        setupResizers();
    }

    // Edit functionality setup
    setupEditingButtons();

    // Execute button setup
    document.getElementById('execute').addEventListener("click", handleExecute);
    document.getElementById('execute').addEventListener("touchstart", handleExecute);

    // Key commands
    setupKeyboardShortcuts();

    // Hide loading indicator if exists
    const loadingElement = document.getElementById('loading');
    if (loadingElement) {
        loadingElement.style.visibility = "hidden";
    }

    // Hide platform-specific help
    if (/(Mac|iPhone|iPod|iPad)/i.test(navigator.userAgent)) {
        const winHelp = document.getElementById('winhelp');
        if (winHelp) winHelp.style.display = "none";
    } else {
        const macHelp = document.getElementById('machelp');
        if (macHelp) macHelp.style.display = "none";
    }

    // Check if mobile
    if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
        isMobile = true;
    }

    // Window unload warning
    /*
    window.onbeforeunload = function(e) {
        e.preventDefault();
        return "Leaving this page may cause loss of your code!";
    };
    window.beforeunload = function(e) {
        e.preventDefault();
        return "Leaving this page may cause loss of your code!";
    };
    */
}

function setupNavigation(editorContainer) {
    const navToggle = document.querySelector(".editor-nav-toggle");
    const nav = document.querySelector(".editor-header > nav");
    const dropdowns = document.querySelectorAll(".editor-nav-item.dropdown");

    if (navToggle && nav) {
        navToggle.addEventListener("click", () => {
            navToggle.setAttribute("aria-expanded", !nav.hasAttribute("data-visible"));
            nav.toggleAttribute("data-visible");
        });
    }

    if (dropdowns) {
        dropdowns.forEach((d) => {
            d.addEventListener("mouseover", (e) => {
                const dropdown = e.currentTarget.querySelector("div");
                if (dropdown) dropdown.style.display = "block";
            });

            d.addEventListener("mouseleave", (e) => {
                const dropdown = e.currentTarget.querySelector("div");
                if (dropdown) dropdown.style.display = "none";
            });

            onClickOutside(d, () => {
                const dropdown = d.querySelector("div");
                if (dropdown) dropdown.style.display = "none";
            });

            d.addEventListener("click", (e) => {
                const dropdown = e.currentTarget.querySelector("div");
                if (dropdown) {
                    if (dropdown.style.getPropertyValue("display") === "none") {
                        dropdown.style.display = "block";
                    } else {
                        dropdown.style.display = "none";
                    }
                }
            });
        });
    }
}

function setupTabs(editorContainer) {
    const tabsList = editorContainer.querySelector("ul");
    if (!tabsList) return;

    const tabButtons = tabsList.querySelectorAll(".tabBtn");
    const tabPanels = editorContainer.querySelectorAll(".editor-tab-panels > div");

    tabsList.setAttribute("role", "tablist");

    tabsList.querySelectorAll("li").forEach((listitem) => {
        listitem.setAttribute("role", "presentation");
    });

    tabButtons.forEach((tab, index) => {
        tab.setAttribute("role", "tab");
        if (index === 0) {
            tab.setAttribute("aria-selected", "true");
        } else {
            tab.setAttribute("tabindex", "-1");
            tabPanels[index].setAttribute("aria-hidden", "true");
        }
    });

    tabPanels.forEach((panel) => {
        panel.setAttribute("role", "tabpanel");
        panel.setAttribute("tabindex", "0");
    });

    editorContainer.addEventListener("click", (e) => {
        const clickedTab = e.target.closest("a.tabBtn");
        if (!clickedTab) return;
        e.preventDefault();
        switchTab(clickedTab);
    });

    editorContainer.addEventListener("keydown", (e) => {
        switch (e.key) {
            case "ArrowLeft":
                moveLeft();
                break;
            case "ArrowRight":
                moveRight();
                break;
            case "Home":
                e.preventDefault();
                switchTab(tabButtons[0]);
                break;
            case "End":
                e.preventDefault();
                switchTab(tabButtons[tabButtons.length - 1]);
                break;
        }
    });

    function moveLeft() {
        const currentTab = document.activeElement;
        if (!currentTab.parentElement.previousElementSibling) {
            switchTab(tabButtons[tabButtons.length - 1]);
        } else {
            switchTab(currentTab.parentElement.previousElementSibling.querySelector("a"));
        }
    }

    function moveRight() {
        const currentTab = document.activeElement;
        if (!currentTab.parentElement.nextElementSibling) {
            switchTab(tabButtons[0]);
        } else {
            switchTab(currentTab.parentElement.nextElementSibling.querySelector("a"));
        }
    }
}

function switchTab(newTab) {
    if (!newTab) return;

    const editorContainer = document.querySelector(".editor-container");
    if (!editorContainer) return;

    const activePanelId = newTab.getAttribute("href");
    const activePanel = editorContainer.querySelector(activePanelId);
    const tabButtons = editorContainer.querySelectorAll(".tabBtn");
    const tabPanels = editorContainer.querySelectorAll(".editor-tab-panels > div");

    if (!activePanel) return;

    tabButtons.forEach((button) => {
        button.setAttribute("aria-selected", "false");
        button.setAttribute("tabindex", "-1");
    });

    tabPanels.forEach((panel) => {
        panel.setAttribute("aria-hidden", "true");
    });

    activePanel.setAttribute("aria-hidden", "false");
    newTab.setAttribute("aria-selected", "true");
    newTab.setAttribute("tabindex", "0");
    newTab.focus();
}
function openTitleForChange(){
    if (getCookie('auid') === '' || getCookie('auid') === null) {
        window.location = "/market/login.jsp?type=cg";
        return;
    }
    const titleElement = document.getElementById('title');
    const fullTitle = titleElement.getAttribute("data-original-title") || titleElement.innerText;
    document.getElementById('project_newtitle').value = fullTitle;
    activateTab("title_change");
}
function cancelProjectTitle(){
    activateTab("code");
}
function setProjectTitle() {
    const titleInput = document.getElementById('project_newtitle');
    const title = titleInput.value.trim();
    const errorElement = document.getElementById('title_error');

    // Reset error state
    errorElement.innerHTML = '';
    errorElement.style.color = '#f00';

    // Clear error message after 8 seconds
    setTimeout(() => {
        errorElement.innerHTML = '';
    }, 8000);

    // Validate title
    if (title === '') {
        errorElement.innerHTML = 'Project title cannot be empty';
        return false;
    }

    if (!/^[a-zA-Z0-9_ ()&#,'-.+?]*$/.test(title)) {
        errorElement.innerHTML = 'Project title contains invalid characters';
        return false;
    }

    if (title.length > 60) {
        errorElement.innerHTML = 'Project title should be less than 60 characters';
        return false;
    }

    // Create truncated version for display
    const truncatedTitle = title.length > 30 ? title.substring(0, 30) + "..." : title;
    const projecttitle = title;
    const content = editor.getValue();

    // Show loading indicator
    const loadingElement = document.getElementById('loading');
    if (loadingElement) {
        loadingElement.style.visibility = "visible";
    }

    // Prepare data for request
    const formData = new FormData();
    formData.append('langid', langid);
    formData.append('projectid', projectid);
    formData.append('content', content);
    formData.append('projecttitle', projecttitle);

    // Send fetch request
    fetch(SERVER + "/save_project.php", {
        method: 'POST',
        body: formData,
        credentials: 'include'
    })
    .then(response => {
        if (!response.ok) {
            throw new Error('Network response was not ok');
        }
        return response.json();
    })
    .then(data => {
        if (data.status) {
            errorElement.innerHTML = data.message;
        } else {
            projectid = data.projectid;

            // Update title display
            const titleElement = document.getElementById('title');
            titleElement.setAttribute("data-original-title", projecttitle);
            titleElement.setAttribute("title", projecttitle);
            titleElement.innerText = truncatedTitle + " ";

            // Show success message
            errorElement.style.color = '#04af2f';
            errorElement.innerHTML = "Project title changed and saved successfully!";

            // Update terminal or iframe with success message
            const terminalField = document.getElementById("terminal");
            const iframe = document.getElementById("result");

            if (terminalField && terminalField.style.display !== "none" && terminal) {
                var value = terminal.getValue() + "Project title changed and saved successfully!\n";
                terminal.setValue(value, 1);
                result = terminal.getValue();
                terminal.focus();
            } else if (iframe && iframe.style.display !== "none" && iframe.contentDocument) {
                iframe.contentDocument.body.innerHTML = "Project title changed and saved successfully!\n";
            }

            // Switch to code tab after delay
            setTimeout(() => {
                activateTab("code");
            }, 5000);
        }

        // Hide loading indicator
        if (loadingElement) {
            loadingElement.style.visibility = "hidden";
        }
    })
    .catch(error => {
        console.error("Error saving project title:", error);
        errorElement.innerHTML = "An error occurred while saving the project title.";

        // Hide loading indicator
        if (loadingElement) {
            loadingElement.style.visibility = "hidden";
        }
    });
}
/**
 * Activates a tab by ID and handles ARIA attributes correctly
 * @param {string} tabId - The ID of the tab to activate
 */
function activateTab(tabId) {
    // Get all tab content elements
    const tabContents = document.querySelectorAll('.tab-content');
    // Hide all tabs first
    if (tabContents && tabContents.length > 0) {
        tabContents.forEach(tab => {
            if (tab) {
                tab.setAttribute('aria-hidden', 'true');
                tab.setAttribute('hidden', 'true');
            }
        });
    }
    // Show the selected tab
    const selectedTab = document.getElementById(tabId);
    if (selectedTab) {
        selectedTab.setAttribute('aria-hidden', 'false');
        selectedTab.removeAttribute('hidden');
    }
}

function generateShareLinkDropdown() {
    if (getCookie('auid') === '' || getCookie('auid') === null) {
        window.location = "/market/login.jsp?type=cg";
        return;
    }

    fetch(SERVER + "/captcha.php", {
        method: "POST",
        credentials: "include"
    })
    .then(response => {
        if (!response.ok) {
            throw new Error("Network response was not ok");
        }
        return response.text();
    })
    .then(text => {
        const shareElement = document.getElementById("share");
        if (shareElement) {
            shareElement.innerHTML = text;
            activateTab("share");
        }
    })
    .catch(error => {
        const shareElement = document.getElementById("share");
        if (shareElement) {
            shareElement.innerHTML = error.message || "An error occurred";
            activateTab("share");
        }
        console.error("Error generating share link:", error);
    });
}

function createProject() {
    if (getCookie('auid') === '' || getCookie('auid') === null) {
        window.location = "/market/login.jsp?type=cg";
        return;
    }

    // Show loading indicator
    const loadingElement = document.getElementById('loading');
    if (loadingElement) {
        loadingElement.style.visibility = "visible";
    }

    // Prepare form data
    const formData = new FormData();
    formData.append('langid', langid);

    fetch(SERVER + "/reset_project.php", {
        method: 'POST',
        body: formData,
        credentials: 'include'
    })
    .then(response => {
        if (!response.ok) {
            throw new Error('Network response was not ok');
        }
        return response.json();
    })
    .then(data => {
        window.location = '/compilers/index.htm';

        // Hide loading indicator
        if (loadingElement) {
            loadingElement.style.visibility = "hidden";
        }
    })
    .catch(error => {
        console.error("Error creating project:", error);

        // Hide loading indicator
        if (loadingElement) {
            loadingElement.style.visibility = "hidden";
        }
    });
}

function saveAsNewProject() {
    if (getCookie('auid') === '' || getCookie('auid') === null) {
        window.location = "market/login.jsp?type=cg";
        return;
    }

    const content = editor.getValue();
    if (content.length === 0) {
        return; // Don't save empty content
    }

    // Show loading indicator
    const loadingElement = document.getElementById('loading');
    if (loadingElement) {
        loadingElement.style.visibility = "visible";
    }

    // Prepare form data
    const formData = new FormData();
    formData.append('langid', langid);
    formData.append('content', content);
    formData.append('projecttitle', projecttitle);

    fetch(SERVER + "/save_as_new_project.php", {
        method: 'POST',
        body: formData,
        credentials: 'include'
    })
    .then(response => {
        if (!response.ok) {
            throw new Error('Network response was not ok');
        }
        return response.json();
    })
    .then(data => {
        if (data.status) {
            // Show error message using native alert (instead of $.messager.alert)
            alert(data.message);
        } else {
            // Update terminal or iframe with success message
            const terminalField = document.getElementById("terminal");
            const iframe = document.getElementById("result");

            if (terminalField && terminalField.style.display !== "none" && terminal) {
                var value = terminal.getValue() + "Project saved as new Successfully!\n";
                terminal.setValue(value, 1);
                result = terminal.getValue();
                terminal.focus();
            } else if (iframe && iframe.style.display !== "none" && iframe.contentDocument) {
                iframe.contentDocument.body.innerHTML = "Project saved as new Successfully!\n";
            } else {
                console.log("Neither terminal nor iframe is displayed.");
            }
        }

        // Hide loading indicator
        if (loadingElement) {
            loadingElement.style.visibility = "hidden";
        }
    })
    .catch(error => {
        console.error("Error saving project as new:", error);

        // Hide loading indicator
        if (loadingElement) {
            loadingElement.style.visibility = "hidden";
        }
    });
}

