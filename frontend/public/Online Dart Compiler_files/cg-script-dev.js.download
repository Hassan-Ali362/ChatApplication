function getCookie(name) {
    var cookieArr = document.cookie.split(";");
    for (var i = 0; i < cookieArr.length; i++) {
        var cookiePair = cookieArr[i].split("=");
        if (name == cookiePair[0].trim()) {
            return decodeURIComponent(cookiePair[1]);
        }
    }
    return null;
}
function createCookie(name, value, days) {
    if (days) {
        var date = new Date();
        date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
        var expires = "; expires=" + date.toGMTString();
    }
    else var expires = "";
    document.cookie = name + "=" + value + expires + "; path=/";
}
function setupResizers() {
    const resizers = document.querySelectorAll(".editor-resizer");

    resizers.forEach(element => {
        const leftPane = element.previousElementSibling;
        const rightPane = element.nextElementSibling;

        const handlePointerDown = (e) => {
            isResizing = true;
            element.setPointerCapture(e.pointerId);
            const handleMove = (e) => handleMouseMove(e, leftPane, rightPane);

            document.addEventListener('mousemove', handleMove);
            document.addEventListener('pointermove', handleMove);

            const handleUp = () => {
                isResizing = false;
                document.removeEventListener('mousemove', handleMove);
                document.removeEventListener('pointermove', handleMove);
                element.removeEventListener('pointerup', handleUp);
            };

            element.addEventListener('pointerup', handleUp);
        };

        element.addEventListener('pointerdown', handlePointerDown);
    });
}

function handleMouseMove(event, leftPane, rightPane) {
    if (isResizing) {
        if (window.innerWidth > 1000) {
            const containerRect = leftPane.getBoundingClientRect();
            const newWidth = event.clientX - containerRect.left;
            leftPane.style.width = `${newWidth}px`;
            rightPane.style.width = `calc(100% - ${newWidth}px)`;
        } else {
            const containerRect = leftPane.getBoundingClientRect();
            const newHeight = event.clientY - containerRect.top;
            leftPane.style.height = `${newHeight}px`;
            rightPane.style.height = `calc(100% - ${newHeight}px)`;
        }
    }
}

function setupEditingButtons() {
    // Undo button
    document.getElementById('undo')?.addEventListener("click", () => {
        if (editor.getSession().getUndoManager().hasUndo()) {
            editor.getSession().getUndoManager().undo(false);
        }
    });
    document.getElementById('undo')?.addEventListener("touchstart", () => {
        if (editor.getSession().getUndoManager().hasUndo()) {
            editor.getSession().getUndoManager().undo(false);
        }
    });

    // Redo button
    document.getElementById('redo')?.addEventListener("click", () => {
        if (editor.getSession().getUndoManager().hasRedo()) {
            editor.getSession().getUndoManager().redo(false);
        }
    });
    document.getElementById('redo')?.addEventListener("touchstart", () => {
        if (editor.getSession().getUndoManager().hasRedo()) {
            editor.getSession().getUndoManager().redo(false);
        }
    });

    // Cut button
    document.getElementById('cut')?.addEventListener("click", () => {
        var selectedRange = editor.getSelectionRange();
        if (editor.getSession().getTextRange(selectedRange)) {
            clipboard = editor.getSession().getTextRange(selectedRange);
            editor.getSession().remove(selectedRange);
        }
    });
    document.getElementById('cut')?.addEventListener("touchstart", () => {
        var selectedRange = editor.getSelectionRange();
        if (editor.getSession().getTextRange(selectedRange)) {
            clipboard = editor.getSession().getTextRange(selectedRange);
            editor.getSession().remove(selectedRange);
        }
    });

    // Delete button
    document.getElementById('delete')?.addEventListener("click", () => {
        var selectedRange = editor.getSelectionRange();
        if (editor.getSession().getTextRange(selectedRange)) {
            editor.getSession().remove(selectedRange);
        }
    });
    document.getElementById('delete')?.addEventListener("touchstart", () => {
        var selectedRange = editor.getSelectionRange();
        if (editor.getSession().getTextRange(selectedRange)) {
            editor.getSession().remove(selectedRange);
        }
    });

    // Copy button
    document.getElementById('copy')?.addEventListener("click", () => {
        var selectedRange = editor.getSelectionRange();
        if (editor.getSession().getTextRange(selectedRange)) {
            clipboard = editor.getSession().getTextRange(selectedRange);
        }
    });
    document.getElementById('copy')?.addEventListener("touchstart", () => {
        var selectedRange = editor.getSelectionRange();
        if (editor.getSession().getTextRange(selectedRange)) {
            clipboard = editor.getSession().getTextRange(selectedRange);
        }
    });

    // Paste button
    document.getElementById('paste')?.addEventListener("click", () => {
        var position = editor.getCursorPosition();
        editor.getSession().insert(position, clipboard);
    });
    document.getElementById('paste')?.addEventListener("touchstart", () => {
        var position = editor.getCursorPosition();
        editor.getSession().insert(position, clipboard);
    });

    // Select all button
    document.getElementById('select')?.addEventListener("click", () => {
        editor.getSelection().selectAll();
    });
    document.getElementById('select')?.addEventListener("touchstart", () => {
        editor.getSelection().selectAll();
    });

    // Find button
    document.getElementById('find')?.addEventListener("click", () => {
        editor.execCommand("find");
    });
    document.getElementById('find')?.addEventListener("touchstart", () => {
        editor.execCommand("find");
    });

    // Find and replace button
    document.getElementById('findreplace')?.addEventListener("click", () => {
        editor.execCommand("replace");
    });
    document.getElementById('findreplace')?.addEventListener("touchstart", () => {
        editor.execCommand("replace");
    });
}

function setupKeyboardShortcuts() {
    window.addEventListener('keydown', function(event) {
        if (event.ctrlKey || event.metaKey) {
            switch (String.fromCharCode(event.which).toLowerCase()) {
                case 'd':
                    event.preventDefault();
                    alert('ctrl-D');
                    break;
                case 'g':
                    event.preventDefault();
                    generateShareLink();
                    break;
                case 'p':
                    createProject();
                    event.preventDefault();
                    event.stopPropagation();
                    break;
                case 'f':
                    event.preventDefault();
                    alert('ctrl-F');
                    break;
            }
        }
    });

    // Editor keyboard commands
    editor.commands.addCommand({
        name: "EditorEnter",
        bindKey: {win: "ctrl+enter", mac: "command+enter"},
        exec: function(editor) {
            switchTab(document.getElementById('tab-1'));
            var code = editor.getValue();
            if (!socket.connected) {
                console.log("Going to reconnect");
                socket.connect();
                timer = 0;
            }
            socket.emit("code", {code: code, language: langid, sessionId: sessionId});
        }
    });
    editor.commands.addCommand({
        name: "ShareKey",
        bindKey: {win: "ctrl+G", mac: "command+G"},
        exec: function(editor) {
            switchTab(document.getElementById('tab-3'));
            generateShareLink();
        }
    });
}

function loadSavedPreferences() {
    // Load saved preferences from localStorage
    if (localStorage.editor_themes) {
        setEditorTheme(localStorage.editor_themes);
    }
    if (localStorage.editor_types) {
        setEditorType(localStorage.editor_types);
    }
    if (localStorage.editor_font) {
        setEditorFontSize(localStorage.editor_font);
    }
    if (localStorage.editor_tab) {
        setEditorTabSize(localStorage.editor_tab);
    }
    if (localStorage.editor_invisible === "false") {
        setEditorInvisible(false);
    } else if (localStorage.editor_invisible === "true") {
        setEditorInvisible(true);
    }
    if (localStorage.editor_gutter === "false") {
        setEditorGutter(false);
    } else if (localStorage.editor_gutter === "true") {
        setEditorGutter(true);
    }

    // Set initial editor focus
    editor.renderer.setScrollMargin(5);
    editor.focus();
    editor.navigateFileEnd();
}

function configureInterfaceForLanguage() {
    // Hide result div initially
    document.getElementById('result').style.display = "none";

    // Configure interface based on language
    if (langid === "angularjs" || langid === "p5js" || langid === "vuejs") {
        preview = false;
        compile = false;
        execute = true;
    } else if (modename === "html" || modename === "css") {
        preview = true;
        compile = false;
        execute = false;
    } else if (modename === "coffee" || modename === "typescript" || modename === "asciidoc" ||
               modename === "rhtml" || modename === "markdown" || modename === "mathml") {
        preview = false;
        compile = false;
        execute = true;
    }

    console.log("Preview " + preview);
    console.log("Modename " + modename);

    // Set up display for preview or execute mode
    if (preview || langid === "rscript" || langid === "phpweb" || langid === "matplotlib" || langid === "octave" || langid === "latex") {
        document.getElementById('terminal').style.display = "none";
        document.getElementById('result').style.display = "block";
    } else if (execute) {
        document.getElementById('terminal').style.display = "none";
        document.getElementById('result').style.display = "block";
    }

    // Add preview update handler
    if (preview) {
        editor.commands.on('afterExec', eventData => {
            updatePreview();
        });
    }
}

function updatePreview() {
    if (!preview) return;

    var iframe = document.getElementById("result");
    var frameDoc = iframe.document;
    if (iframe.contentWindow) {
        frameDoc = iframe.contentWindow.document;
    }
    frameDoc.open();
    frameDoc.write(editor.getValue());
    frameDoc.close();
}

function initSocket() {
    if (init) {
        // If already initialized
        return;
    }
    if (!compile) {
        // No need to initialize
        return;
    }

    init = 1;
    console.log("Going to initialize socket...");
    switchTab(document.getElementById('tab-1'));

    // Determine server based on language
    var server = "https://tpcg2.tutorialspoint.com";
    if (langid == "befunge" || langid == "brainfuck" || langid == "fbc" || langid == "elixir" ||
        langid == "basic" || langid === "nodejsterm" || langid === "unixterm" ||
        langid === "python3term" || langid === "ksh" || langid === "fantom" ||
        langid === "matplotlib" || langid === "numpyterm" || langid === "scipyterm" ||
        langid === "scipy" || langid === "numpy" || langid === "rscript" || langid === "latex" ||
        langid == "lua" || langid == "luaterm" || langid === "d" || langid === "rterm" ||
        langid == "pashterm" || langid == "forth" || langid === "tcl" || langid === "lisp" ||
        langid === "icon" || langid === "intercal" || langid === "octave" ||
        langid === "octaveterm" || langid === "pascal" || langid == "prolog" ||
        langid == "rust" || langid == "scheme" || langid == "smalltalk" || langid === "ruby" ||
        langid === "rubytermi" || langid == "php" || langid == "smlnj" || langid == "phpweb" ||
        langid == "verilog" || langid === "jython" || langid === "clojure" ||
        langid === "unlambda" || langid === "clojure" ||
        langid === "pike" || langid === "pari") {
        server = "https://tpcg2.tutorialspoint.com";
    } else if (langid === "javascript" || langid == "awk" || langid == "bash" ||
               langid == "c" || langid == "cpp" || langid == "c99" || langid == "cpp0x" ||
               langid == "cpp11" || langid == "cpp20" || langid == "fortran" ||
               langid == "erlang" || langid == "yasm" || langid == "objc" ||
               langid == "swift" || langid == "ada" || langid == "algol" ||
               langid === "asm" || langid == "csharp" || langid == "fsharp" ||
               langid == "vb.net" || langid == "ilasm" || langid === "java" ||
               langid === "java8" || langid == "cobol" || langid == "factor" ||
               langid == "cbasic" || langid === "kotlin" || langid === "rexx" ||
               langid === "golang" || langid === "groovy" || langid === "haxe" ||
               langid === "haskell" || langid === "dart" || langid === "scala" ||
               langid === "perl" || langid === "wspace" || langid === "julia" || langid === "sqlite" ||
               langid === "python3" || langid == "python") {
        server = "https://tpcg1.tutorialspoint.com";
    }

    // Set up socket connection
    socket = io.connect(server + '/' + '?sessionId=' + sessionId + '&lang=' + langid, {
        transports: ["websocket"]
    });

    // Set up connection monitoring
    var interval = window.setInterval(function() {
        timer++;
        if (timer > 100 && socket.connected) {
            socket.disconnect();
            timer = 0;
        }
    }, 1000);

    // Socket event handlers
    socket.on('connect_error', function(error) {
        terminal.setValue("Error while connecting with the server", 1);
    });

    socket.on('connect', function(error) {
        terminal.setValue("", 1);
        editor.focus();

        // Initialize terminal environment based on language
        if (langid === "unixterm") {
            terminal.focus();
            socket.emit("command", 'export "PS1=$ "');
        } else if (langid === "rterm") {
            terminal.focus();
            socket.emit("command", 'export "PS1=$ "');
            socket.emit("command", 'R');
        } else if (langid === "nodejsterm") {
            terminal.focus();
            socket.emit("command", 'export "PS1=$ "');
            socket.emit("command", 'node');
        } else if (langid === "rubyterm") {
            terminal.focus();
            socket.emit("command", 'export "PS1=$ "');
            socket.emit("command", 'irb');
        } else if (langid === "luaterm") {
            terminal.focus();
            socket.emit("command", 'export "PS1=$ "');
            socket.emit("command", 'lua');
        } else if (langid === "phpterm") {
            terminal.focus();
            socket.emit("command", 'export "PS1=$ "');
            socket.emit("command", 'php -a');
        } else if (langid === "python3term") {
            terminal.focus();
            socket.emit("command", 'export "PS1=$ "');
            socket.emit("command", 'python3');
        } else if (langid === "numpyterm") {
            terminal.focus();
            socket.emit("command", 'export "PS1=$ "');
            socket.emit("command", 'python3');
        } else if (langid === "scipyterm") {
            terminal.focus();
            socket.emit("command", 'export "PS1=$ "');
            socket.emit("command", 'python3');
        } else if (langid === "pashterm") {
            terminal.focus();
            socket.emit("command", 'export "PS1=$ "');
            socket.emit("command", 'pwsh');
        } else if (langid === "octaveterm") {
            terminal.focus();
            socket.emit("command", 'export "PS1=$ "');
            socket.emit("command", 'octave');
        }
    });
    // Process output from server
    socket.on('output', function(data) {
        resetButtonState();
        switchTab(document.getElementById('tab-1'));

        // Handle special language outputs
	if (langid === "latex" || langid === "rscript" || langid === "matplotlib" || langid === "octave" || langid === "phpweb") {
	    console.log( data );
            var iframe = document.getElementById('result');
            const iframeDocument = iframe.contentDocument || iframe.contentWindow.document;
            if (iframeDocument) {
                iframeDocument.body.innerHTML = data;
            }

            const loadingElement = document.getElementById('loading');
            if (loadingElement) {
                loadingElement.style.visibility = "hidden";
            }
            return;
        }
	
        // Process normal output
        if (cmd.length > 0) {
            if (data.startsWith(cmd)) {
                data = data.slice(cmd.length);
            }
        }

        // Reset timer and update terminal
        timer = 0;
        data = data.trimLeft();
	console.log( data );
        var value = terminal.getValue() + data;
        terminal.setValue(value, 1);
        cmd = "";
        result = terminal.getValue();

        // Handle mobile display
        if (isMobile && langid.indexOf("term") == -1) {
            // Mobile display logic
        }

        terminal.focus();

        const loadingElement = document.getElementById('loading');
        if (loadingElement) {
            loadingElement.style.visibility = "hidden";
        }
    });
}
// Function to reset button state
function resetButtonState() {
    const executeIcon = document.getElementById('execute-icon');
    const loadingIcon = document.getElementById('loading-icon');

    if (executeIcon && loadingIcon) {
        executeIcon.classList.remove('hidden');
        loadingIcon.classList.add('hidden');
        loadingIcon.classList.remove('rotating');
    }
}

function handleExecute(e) {
     // Show loading state
    const executeIcon = document.getElementById('execute-icon');
    const loadingIcon = document.getElementById('loading-icon');
    const executeText = document.getElementById('execute-text');

    if (executeIcon && loadingIcon && executeText) {
        executeIcon.classList.add('hidden');
        loadingIcon.classList.remove('hidden');
        loadingIcon.classList.add('rotating');
    }
    if (!init) {
        initSocket();
    }

    switchTab(document.getElementById('tab-1'));

    if (!execute && !preview && !socket.connected) {
        /* If socket is disconnected then connect it again */
        console.log("Going to reconnect");
        socket.connect();
        timer = 0;
    }

    const loadingElement = document.getElementById('loading');
    if (loadingElement) {
        loadingElement.style.visibility = "visible";
    }

    terminal.setValue("", 1);

    // Handle special languages
    if (langid === "angularjs" || langid === "rscript" || langid === "phpweb" ||
        langid === "matplotlib" || langid === "octave" || langid === "latex") {
        var iframe = document.getElementById('result');
        const iframeDocument = iframe.contentDocument || iframe.contentWindow.document;
        if (iframeDocument) {
            iframeDocument.body.innerHTML = "";
        }
    }

    var code = editor.getValue();
    // Handle preview mode
    if (preview) {
        updatePreview();
        if (executeIcon && loadingIcon && executeText) {
            executeIcon.classList.remove('hidden');
            loadingIcon.classList.add('hidden');
            loadingIcon.classList.remove('rotating');
        }
        if (loadingElement) {
            loadingElement.style.visibility = "hidden";
        }

        if (isMobile && langid.indexOf("term") == -1) {
            switchTab(document.getElementById('tab-1'));
        }
        return;
    } else if (execute) {
        if (loadingElement) {
            loadingElement.style.visibility = "visible";
        }

        var url = "https://tools.tutorialspoint.com/webview1.php";
        var formData = new FormData();
        formData.append('lang', langid);
        formData.append('code', code);

        fetch(url, {
            method: 'POST',
            credentials: 'include',
            body: formData
        }).then(response => {
            // Check if the request was successful
            if (!response.ok) {
                terminal.setValue("Some error caused the issue", 1);
                resetButtonState();
                throw new Error('Network response was not ok');
            }
            // Parse the response as text
            return response.text();
        }).then(data => {
            if (loadingElement) {
                loadingElement.style.visibility = "hidden";
            }
            var iframe = document.getElementById("result");
            var frameDoc = iframe.document;
            if (iframe.contentWindow) {
                frameDoc = iframe.contentWindow.document;
            }
            frameDoc.open();
            console.log("Pt1....inside error");
            frameDoc.write(data);
            frameDoc.close();
            console.log("Pt2....inside error");
            resetButtonState();
            console.log("Pt3....inside error");
            return;
        }).catch(error => {
            console.log("Pt4....inside error");
            terminal.setValue(error, 1);
            resetButtonState();
        });
        if (isMobile && langid.indexOf("term") == -1) {
            switchTab(document.getElementById('tab-1'));
        }
        return;
    }

    // Handle compile mode (default)
    socket.emit("code", {code: code, language: langid, sessionId: sessionId});

    if (!isMobile) {
        editor.focus();
    }
}

function onClickOutside(el, cb) {
    document.addEventListener("click", (event) => {
        if (
            !el.contains(event.target) &&
            ![...event.target.classList].includes("tutorial-toc-toggle") &&
            ![...event.target.classList].includes("accent-nav__toggle") &&
            ![...event.target.classList].includes("nav-toggle")
        )
        cb();
    });
}
document.addEventListener('DOMContentLoaded', function() {
    // Select all links with the class js-project-action
    const projectLinks = document.querySelectorAll('.js-project-action');

    // Add click event listener to each link
    projectLinks.forEach(link => {
        link.addEventListener('click', function(e) {
            // Prevent the default link behavior
            e.preventDefault();

            // Get the action from the data-action attribute
            const action = this.getAttribute('data-action');

            // Call the appropriate function based on the action
            switch(action) {
                case 'create':
                    createProject();
                    break;
                case 'save':
                    saveProject();
                    break;
                case 'save-as':
                    saveAsNewProject();
                    break;
                case 'share':
                    generateShareLinkDropdown();
                    break;
                case 'search':
                    openSearchProject();
                    break;
                case 'save-title':
                    setProjectTitle();
                    break;
                case 'cancel-title':
                    cancelProjectTitle();
                    break;
                case 'logout':
                    userLogout();
                    break;
            }
        });
    });
});
function setEditorTheme(theme) {
    editor_theme = theme;
    editor.setTheme("ace/theme/" + editor_theme);
    terminal.setTheme("ace/theme/" + editor_theme);
    localStorage.editor_themes = editor_theme;
}

function setEditorType(type) {
    editor_type = type;
    var handler;
    if (editor_type === "vim") {
        handler = "ace/keyboard/vim";
    }
    if (editor_type === "emacs") {
        handler = "ace/keyboard/emacs";
    }
    if (editor_type === "ace") {
        handler = null;
    }
    editor.setKeyboardHandler(handler);
    localStorage.editor_types = editor_type;
}

function setEditorFontSize(size) {
    editor_font_size = parseInt(size);
    editor.setFontSize(editor_font_size);
    localStorage.editor_font = editor_font_size;
    editor.resize(true);
}

function setEditorTabSize(size) {
    editor_tab_size = parseInt(size);
    editor.getSession().setTabSize(editor_tab_size);
    localStorage.editor_tab = editor_tab_size;

    var code = editor.getValue();
    editor.setValue(code);
    editor.resize(true);
    editor.clearSelection();
}

function setEditorInvisible(flag) {
    editor_invisible = flag;
    editor.setShowInvisibles(flag);
    localStorage.editor_invisible = editor_invisible;
}

function setEditorGutter(flag) {
    editor_gutter = flag;
    editor.renderer.setShowGutter(flag);
    localStorage.editor_gutter = editor_gutter;
}

// Server URL constant
const SERVER = "https://www.tutorialspoint.com/cg";

function generatePublicLink() {
    var code = editor.getValue();
    var captcha = document.getElementById('captcha_value').value;

    if (captcha.length < 6) {
        document.getElementById('warning').innerHTML = "Please enter correct captcha from the image";
        setTimeout(function() {
            document.getElementById('warning').innerHTML = "";
        }, 4000);
        return true;
    }

    const loadingElement = document.getElementById('loading');
    if (loadingElement) {
        loadingElement.style.visibility = "visible";
    }

    var url = SERVER + "/show_permalink.php";
    var formData = new FormData();
    formData.append('langid', langid);
    formData.append('captcha', captcha);
    formData.append('projecttitle', projecttitle);
    formData.append('code', code);

    fetch(url, {
        method: 'POST',
        credentials: 'include',
        body: formData
    }).then(response => {
        // Check if the request was successful
        if (!response.ok) {
            document.getElementById('warning').innerHTML = "Network response was not ok";
            setTimeout(function() {
                document.getElementById('warning').innerHTML = "";
            }, 4000);
            return true;
        }
        // Parse the response as JSON
        return response.json();
    }).then(data => {
        if (data.status) {
            document.getElementById('warning').innerHTML = data.message;
            setTimeout(function() {
                document.getElementById('warning').innerHTML = "";
            }, 4000);
        } else {
            document.getElementById('share').innerHTML = data.message;
        }
        return;
    }).catch(error => {
        document.getElementById('share').innerHTML = error;
        return;
    });
}

function generateShareLink() {
    const url = SERVER + "/" + 'captcha.php';
    fetch(url, {
        method: 'POST',
        credentials: 'include',
    }).then(response => {
        // Check if the request was successful
        if (!response.ok) {
            document.getElementById('share').innerHTML = "Some error caused the issue";
            throw new Error('Network response was not ok');
        }
        // Parse the response as text
        return response.text();
    }).then(data => {
        document.getElementById('share').innerHTML = data;
        return true;
    }).catch(error => {
        document.getElementById('share').innerHTML = error;
    });
    return true;
}

function copyToClipboard(containerid) {
    document.getElementById("copied").style.display = "block";

    if (document.selection) {
        var range = document.body.createTextRange();
        range.moveToElementText(document.getElementById(containerid));
        range.select();
    } else if (window.getSelection) {
        var range = document.createRange();
        range.selectNode(document.getElementById(containerid));
        window.getSelection().removeAllRanges();
        window.getSelection().addRange(range);
    }

    setTimeout(function() {
        document.getElementById("copied").style.display = "none";
    }, 3000);

    document.execCommand('copy');
    return true;
}
